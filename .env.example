# Cấu hình mẫu cho Hệ thống chia sẻ file P2P mô phỏng BitTorrent (DS02)
# Sao chép file này thành .env và điều chỉnh thông số phù hợp với máy/mạng của bạn.

# Địa chỉ và cổng của Tracker Server
TRACKER_HOST=0.0.0.0
TRACKER_PORT=8000
TRACKER_URL=http://127.0.0.1:8000

# Thời gian hết hạn heartbeat của Peer trên Tracker (giây)
PEER_TIMEOUT_SECONDS=15

# Cấu hình nút mạng Peer
PEER_ID=PEER_1
PEER_HOST=127.0.0.1
PEER_PORT=6001
PEER_STORAGE_DIR=./peer_storage_6001

# Tham số chia mảnh và tải song song
DEFAULT_CHUNK_SIZE=524288
MAX_DOWNLOAD_THREADS=4
SOCKET_TIMEOUT_SECONDS=3.0
HEARTBEAT_INTERVAL_SECONDS=5.0
